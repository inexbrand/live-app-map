    "@live-app-map/graph": "workspace:*",
    "@live-app-map/iframe-policy": "workspace:*",
    "@live-app-map/mcp-server": "workspace:*",
    "@live-app-map/scanner-docs": "workspace:*",
    "@live-app-map/schema": "workspace:*",
    "@tailwindcss/vite": "^4.3.5",
    "@xyflow/react": "^12.6.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
